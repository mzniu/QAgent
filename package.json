{
  "name": "qagent",
  "version": "0.1.0",
  "description": "QAgent v0.1 — design document in, test artifacts out (human review required)",
  "type": "module",
  "bin": {
    "qagent": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "generate": "tsx src/cli.ts generate",
    "smoke": "tsx src/cli.ts generate fixtures/sample-design-doc.md -o /tmp/qagent-smoke --mock",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run smoke"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["qa", "testing", "claude", "agent"],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "gray-matter": "^4.0.3",
    "mammoth": "^1.9.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}